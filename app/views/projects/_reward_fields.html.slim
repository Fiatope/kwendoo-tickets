.nested-fields[style="background-color:#f2f2f2;padding:2rem;margin-bottom:1rem;-webkit-box-shadow: 0px 2px 2px 0px rgba(119,119,119,0.3);-moz-box-shadow: 0px 2px 2px 0px rgba(119,119,119,0.3);box-shadow: 0px 2px 2px 0px rgba(119,119,119,0.3);"]
  .row
    .small-12.columns
      = f.input :title
    .small-12.medium-6.columns
      = f.input :minimum_value
    .small-12.medium-6.columns
      = f.input :maximum_contributions
    .small-12.columns
      = f.input :promote, as: :boolean
    .small-12.columns
      = f.input :couple, as: :boolean
    .small-12.columns
      = link_to_remove_association "X", f, class: "delete"
  .row
    .small-12.columns
      = f.input :description, label: "Description", input_html: { rows: 4 }
    .small-12.columns
      = f.input :ticket_template_image, as: :file, label: "Modele image du billet (optionnel)"
      - if f.object.ticket_template_image.present?
        .image-preview
          = image_tag(f.object.ticket_template_image.url, style: 'max-width:220px;max-height:120px;')
    
